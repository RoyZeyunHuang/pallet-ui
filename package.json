{
  "name": "@pallet/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoyZeyunHuang/pallet-ui.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "//files": "限制作为 git 依赖安装时打包的内容——demo/ 不该进使用方的 node_modules",
  "files": [
    "src",
    "scripts",
    "components.json",
    "AGENTS.md"
  ],
  "scripts": {
    "demo": "npm --prefix demo run dev",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "normalize-imports": "node scripts/normalize-imports.mjs",
    "add": "shadcn add"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "//peer": "styles.css 里 @import \"tailwindcss\"，由使用方提供（devDependencies 里也装一份，本仓库的 demo 才能自己构建）",
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
